{
  "name": "temp-master",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @temp-master/web dev",
