  "TC-09": {
    "id": "TC-09",
    "name": "Time Range 切替でのグラフ点数とラベル書式 (SEED-D1)",
    "target": "ios-remote",
    "expected": {
      "points": {
        "hour": 1,
        "day": 2,
        "week": 3,
        "month": 4,
        "year": 5
      },
      "label_regex": {
        "hour": "^\\d{2}:\\d{2}$",
        "day": "^\\d{2}:\\d{2}$",
        "week": "^(Sun|Mon|Tue|Wed|Thu|Fri|Sat) \\d{2}$",
        "month": "^[A-Z][a-z]{2} \\d{1,2}$",
        "year": "^[A-Z][a-z]{2} \\d{1,2}$"
      }
    },
    "actual": {
      "points": {
        "year": 5,
        "week": 3,
        "hour": 1,
        "month": 4,
        "day": 2
      },
      "label_regex": {
        "hour": [
          "21:56"
        ],
        "day": [
          "20:26"
        ],
        "week": [
          "Fri 22",
          "Mon 20"
        ],
        "month": [
          "Oct 2",
          "Oct 9",
          "Oct 12"
        ],
        "year": [
          "Jul 4",
          "Oct 2",
          "Oct 9",
          "Oct 12"
        ]
      }
    },
    "key_results": {
      "points": {
        "result": "PASS",
        "expected": {
          "hour": 1,
          "day": 2,
          "week": 3,
          "month": 4,
          "year": 5
        },
        "actual": {
          "year": 5,
          "week": 3,
          "hour": 1,
          "month": 4,
          "day": 2
        }
      },
      "label_regex": {
        "result": "PASS",
        "expected": {
          "hour": "^\\d{2}:\\d{2}$",
          "day": "^\\d{2}:\\d{2}$",
          "week": "^(Sun|Mon|Tue|Wed|Thu|Fri|Sat) \\d{2}$",
          "month": "^[A-Z][a-z]{2} \\d{1,2}$",
          "year": "^[A-Z][a-z]{2} \\d{1,2}$"
        },
        "actual": {
          "hour": [
            "21:56"
          ],
          "day": [
            "20:26"
          ],
          "week": [
            "Fri 22",
            "Mon 20"
          ],
          "month": [
            "Oct 2",
            "Oct 9",
            "Oct 12"
          ],
          "year": [
            "Jul 4",
            "Oct 2",
            "Oct 9",
            "Oct 12"
          ]
        }
      }
    },
    "overall": "PASS",
    "notes": [
      "点数はXCUITestのN pointsを実測。軸ラベルはTC-09_hour/day/week/month/year.pngのD1グラフを視覚確認。右端はSwift Chartsが重複回避で省略。"
    ],
    "screenshot": "ios_screens/TC-09.png"
  },
