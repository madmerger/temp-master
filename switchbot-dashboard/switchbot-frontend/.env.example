# Base URL for the backend API.
# Leave empty when the frontend is served from the FastAPI backend (same origin),
# which is the case for the production/Docker deployment.
# In local development the Vite dev server proxies /api to the backend, so this
# can stay empty. Override the proxy target with VITE_PROXY_TARGET if needed
# (e.g. VITE_PROXY_TARGET=https://temp-master.fly.dev).
VITE_API_URL=
