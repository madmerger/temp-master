# Base URL for the backend API.
# Leave empty to use the same origin that serves the frontend.
# In local development the Vite dev server proxies /api to the backend, so this
# can stay empty. Override the proxy target with VITE_PROXY_TARGET if needed
# (e.g. VITE_PROXY_TARGET=https://snakeroom.fly.dev).
# The production build points at the snakeroom backend via .env.production.
VITE_API_URL=
