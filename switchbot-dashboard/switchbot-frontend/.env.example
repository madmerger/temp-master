# Optional API base URL. When unset, npm run dev uses same-origin and
# production builds default to https://snakeroom.fly.dev.
# VITE_API_URL=

# Milliseconds before a meter is considered stale. Defaults to seven days.
VITE_STALE_METER_THRESHOLD_MS=

# Optional target for the Vite /api development proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8000
